{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hero-section-wizard/hero-section-container",
	"version": "0.1.1",
	"title": "Hero Section Container",
	"category": "widgets",
	"icon": "smiley",
	"description": "Example block scaffolded with Create Block tool.",
	"example": {},
	"allowedBlocks": [
		"hero-section-wizard/hero-section-slider-container",
		"hero-section-wizard/hero-section-secondary-container"
	],
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": false
		},
		"dimensions": {
			"minHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": false
		}
	},
	"attributes": {
		"style": {
			"type": "object",
			"default": {
				"dimensions": {
					"minHeight": "60vh"
				}
			}
		},
		"gap": {
			"type": "number",
			"default": "1"
		}
	},
	"textdomain": "hero-section-wizard",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}