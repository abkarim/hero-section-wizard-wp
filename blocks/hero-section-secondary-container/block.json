{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hero-section-wizard/hero-section-secondary-container",
	"version": "0.1.1",
	"title": "Hero Section Secondary Container",
	"category": "widgets",
	"icon": "smiley",
	"description": "Secondary Container for hero section wizard.",
	"example": {},
	"allowedBlocks": [
		"hero-section-wizard/hero-section-secondary-child"
	],
	"parent": [
		"hero-section-wizard/hero-section-container"
	],
	"supports": {
		"html": false
	},
	"attributes": {
		"borderRadius": {
			"type": "number",
			"default": 0
		},
		"gap": {
			"type": "number",
			"default": "1"
		}
	},
	"textdomain": "hero-section-wizard",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}